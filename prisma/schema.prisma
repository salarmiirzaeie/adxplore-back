// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  INFLUENCER
  BRAND
  ADMIN
}

enum BrandCategory {
  BEAUTY
  FASHION
  FOOD
  HEALTH
  TECH
  EDUCATION
  TRAVEL
  SPORTS
  HOME
  FINANCE
  ENTERTAINMENT
  OTHER
}

enum BrandGoal {
  AWARENESS
  SALES
  CONTENT
  LAUNCH
}

enum BusinessSize {
  SOLO
  SME
  AGENCY
  ENTERPRISE
}

enum FollowerRange {
  UNDER_1K
  FROM_1K_5K
  FROM_5K_10K
  FROM_10K_50K
  FROM_50K_100K
  FROM_100K_500K
  OVER_500K
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  OPEN
  CLOSED
}

enum DeliverableType {
  STORY
  POST
  REEL
}

enum InvitationStatus {
  PENDING
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum DealStatus {
  PENDING_PAYMENT
  IN_PROGRESS
  DELIVERED
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  FAILED
  REFUNDED
}

enum WalletTxType {
  TOP_UP
  ESCROW_HOLD
  ESCROW_RELEASE
  ESCROW_REFUND
  DEAL_EARNING
  WITHDRAW_REQUEST
  WITHDRAW_DONE
  WITHDRAW_CANCEL
}

enum MessageKind {
  TEXT
  SYSTEM
  DELIVERABLE
}

enum InfluencerApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  INVITATION_RECEIVED
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  OFFER_CANCELLED
  DEAL_STARTED
  DELIVERABLE_SUBMITTED
  REVISION_REQUESTED
  DEAL_COMPLETED
  DEAL_CANCELLED
  PAYMENT_REQUIRED
  PAYMENT_HELD
  PAYMENT_RELEASED
  PAYMENT_FAILED
  WALLET_CREDITED
  WALLET_WITHDRAW_REQUESTED
  WALLET_WITHDRAW_COMPLETED
  WALLET_WITHDRAW_REJECTED
  CHAT_MESSAGE
  INFLUENCER_APPROVED
  INFLUENCER_REJECTED
  CAMPAIGN_REJECTED
}

model User {
  id                   String         @id @default(cuid())
  phone                String         @unique
  /// bcrypt hash — used for ADMIN password login only (marketplace users use OTP)
  passwordHash         String?
  name                 String?
  role                 UserRole       @default(INFLUENCER)
  photoUrl             String?
  /// Primary category (first of categories) — used for simple filters
  category             BrandCategory?
  /// JSON array of BrandCategory values
  categories           Json           @default("[]")
  city                 String?
  province             String?
  website              String?
  goal                 BrandGoal?
  businessSize         BusinessSize?
  followerRange        FollowerRange?
  /// Influencers only. Null for brand/admin. Existing influencers backfilled APPROVED.
  approvalStatus       InfluencerApprovalStatus?
  /// Unique code the influencer DMs to @adxplore.ir after onboarding
  instagramVerifyCode  String?        @unique
  instagramDmMarkedSentAt DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  otps                 Otp[]
  campaigns            Campaign[]
  invitationsSent      Invitation[]   @relation("InvitationBrand")
  invitationsReceived  Invitation[]   @relation("InvitationInfluencer")
  offersAsBrand        Offer[]        @relation("OfferBrand")
  offersAsInfluencer   Offer[]        @relation("OfferInfluencer")
  dealsAsBrand         Deal[]         @relation("DealBrand")
  dealsAsInfluencer    Deal[]         @relation("DealInfluencer")
  paymentsAsBrand      Payment[]      @relation("PaymentBrand")
  paymentsAsInfluencer Payment[]      @relation("PaymentInfluencer")
  wallet               Wallet?
  notifications        Notification[]
  conversationsAsBrand       Conversation[] @relation("ConversationBrand")
  conversationsAsInfluencer  Conversation[] @relation("ConversationInfluencer")
  messagesSent               Message[]

  @@index([role, approvalStatus])
}

model Campaign {
  id          String          @id @default(cuid())
  brandId     String
  brand       User            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title       String
  brief       String
  /// Primary category (first of categories) — used for indexes/filters
  category    BrandCategory
  /// JSON array of BrandCategory values
  categories  Json            @default("[]")
  city        String
  province    String?
  /// Primary deliverable (first of deliverables) — used for simple filters
  deliverable DeliverableType
  /// JSON array of DeliverableType values
  deliverables Json           @default("[]")
  budgetMin        Int?
  budgetMax        Int?
  status           CampaignStatus @default(DRAFT)
  rejectionReason  String?
  rejectedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  images      CampaignImage[]
  invitations Invitation[]
  offers      Offer[]
  deals       Deal[]

  @@index([brandId, status])
  @@index([status, category, city])
}

model CampaignImage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([campaignId, sortOrder])
}

model Invitation {
  id           String           @id @default(cuid())
  campaignId   String
  campaign     Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brandId      String
  brand        User             @relation("InvitationBrand", fields: [brandId], references: [id], onDelete: Cascade)
  influencerId String
  influencer   User             @relation("InvitationInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  message      String?
  status       InvitationStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([campaignId, influencerId])
  @@index([brandId, status])
  @@index([influencerId, status])
  @@index([campaignId, status])
}

model Offer {
  id           String         @id @default(cuid())
  campaignId   String
  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brandId      String
  brand        User           @relation("OfferBrand", fields: [brandId], references: [id], onDelete: Cascade)
  influencerId String
  influencer   User           @relation("OfferInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  fee          Int
  message      String?
  deadline     DateTime?
  status       OfferStatus    @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deal         Deal?
  conversation Conversation?

  @@index([brandId, status])
  @@index([influencerId, status])
  @@index([campaignId, status])
}

/// 1:1 chat thread between brand & influencer for an offer
model Conversation {
  id           String    @id @default(cuid())
  offerId      String    @unique
  offer        Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  campaignId   String
  brandId      String
  brand        User      @relation("ConversationBrand", fields: [brandId], references: [id], onDelete: Cascade)
  influencerId String
  influencer   User      @relation("ConversationInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]

  @@index([brandId, updatedAt])
  @@index([influencerId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  kind           MessageKind  @default(TEXT)
  body           String
  /// Structured payload for SYSTEM / DELIVERABLE cards
  metadata       Json?
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Deal {
  id            String     @id @default(cuid())
  offerId       String     @unique
  offer         Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  campaignId    String
  campaign      Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brandId       String
  brand         User       @relation("DealBrand", fields: [brandId], references: [id], onDelete: Cascade)
  influencerId  String
  influencer    User       @relation("DealInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  fee           Int
  status        DealStatus @default(PENDING_PAYMENT)
  contentUrl    String?
  note          String?
  proofUrl      String?
  brandFeedback String?
  submittedAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  payment       Payment?

  @@index([brandId, status])
  @@index([influencerId, status])
  @@index([campaignId, status])
}

/// Escrow payment for a deal (ZarinPal). Brand pays → HELD until deal COMPLETED → RELEASED.
model Payment {
  id            String        @id @default(cuid())
  dealId        String        @unique
  deal          Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  brandId       String
  brand         User          @relation("PaymentBrand", fields: [brandId], references: [id], onDelete: Cascade)
  influencerId  String
  influencer    User          @relation("PaymentInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  amountToman   Int
  amountRial    Int
  description   String?
  authority     String?
  refId         String?
  cardPan       String?
  status        PaymentStatus @default(PENDING)
  errorMessage  String?
  paidAt        DateTime?
  releasedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([brandId, status])
  @@index([influencerId, status])
  @@index([authority])
}

/// Per-user wallet (brand + influencer).
/// Brand: available = spendable balance; held = money locked in active deal escrows.
/// Influencer: available = earnings ready to withdraw; held = pending withdrawal requests.
model Wallet {
  id             String              @id @default(cuid())
  userId         String              @unique
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableToman Int                 @default(0)
  heldToman      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  transactions   WalletTransaction[]
  bankCard       BankCard?
}

/// Saved payout destination (one card per wallet). Snapshotted onto WITHDRAW_REQUEST rows.
model BankCard {
  id         String   @id @default(cuid())
  walletId   String    @unique
  wallet     Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  holderName String
  cardNumber String
  sheba      String
  bankName   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model WalletTransaction {
  id             String       @id @default(cuid())
  walletId       String
  wallet         Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type           WalletTxType
  amountToman    Int
  availableAfter Int
  heldAfter      Int
  dealId         String?
  paymentId      String?
  /// Links DONE/CANCEL rows to the original WITHDRAW_REQUEST
  relatedTxId    String?
  description    String?
  /// Bank card snapshot at payout request time (admin pays this destination)
  payoutHolderName String?
  payoutCardNumber  String?
  payoutSheba       String?
  payoutBankName    String?
  createdAt      DateTime     @default(now())

  @@index([walletId, createdAt])
  @@index([dealId])
  @@index([paymentId])
  @@index([relatedTxId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  linkPath  String?
  entityId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model Otp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, code])
  @@index([phone, expiresAt])
}
