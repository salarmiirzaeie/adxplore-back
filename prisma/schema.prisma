// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  INFLUENCER
  BRAND
}

enum BrandCategory {
  BEAUTY
  FASHION
  FOOD
  HEALTH
  TECH
  EDUCATION
  TRAVEL
  SPORTS
  HOME
  FINANCE
  ENTERTAINMENT
  OTHER
}

enum BrandGoal {
  AWARENESS
  SALES
  CONTENT
  LAUNCH
}

enum BusinessSize {
  SOLO
  SME
  AGENCY
  ENTERPRISE
}

enum FollowerRange {
  UNDER_1K
  FROM_1K_5K
  FROM_5K_10K
  FROM_10K_50K
  FROM_50K_100K
  FROM_100K_500K
  OVER_500K
}

enum CampaignStatus {
  DRAFT
  OPEN
  CLOSED
}

enum DeliverableType {
  STORY
  POST
  REEL
}

model User {
  id            String          @id @default(cuid())
  phone         String          @unique
  name          String?
  role          UserRole        @default(INFLUENCER)
  photoUrl      String?
  category      BrandCategory?
  city          String?
  website       String?
  goal          BrandGoal?
  businessSize  BusinessSize?
  followerRange FollowerRange?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  otps          Otp[]
  campaigns     Campaign[]
}

model Campaign {
  id          String          @id @default(cuid())
  brandId     String
  brand       User            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title       String
  brief       String
  category    BrandCategory
  city        String
  deliverable DeliverableType
  budgetMin   Int?
  budgetMax   Int?
  status      CampaignStatus  @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  images      CampaignImage[]

  @@index([brandId, status])
  @@index([status, category, city])
}

model CampaignImage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([campaignId, sortOrder])
}

model Otp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, code])
  @@index([phone, expiresAt])
}
