# App
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# Local: docker compose up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adxplore"

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS (panel origin)
CORS_ORIGIN=https://app.adxplore.ir,https://admin.adxplore.ir,http://admin.adxplore.ir,http://localhost:5173,http://localhost:5174,http://192.168.108.248:5173
# Melipayamak SMS (never commit real path/key)
# Example: /api/send/shared/YOUR_KEY
SMS_MELIPAYAMAK_PATH=
SMS_BODY_OTP=420054

# OTP settings
OTP_LENGTH=5
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60

# Instagram page used for influencer follow + DM approval
INSTAGRAM_PAGE_USERNAME=adxplore.ir

# Temporary launch switches for influencer signup.
# false (or unset) = no follow/DM and no admin approval; a finished profile is approved.
# Set both to true when the first-user period ends.
INFLUENCER_INSTAGRAM_VERIFICATION_ENABLED=false
INFLUENCER_ADMIN_APPROVAL_REQUIRED=false

# Brand panel: influencer explore and inviting influencers to campaigns.
# false (or unset) hides both. Set to true to turn them back on.
BRAND_INFLUENCER_DISCOVERY_ENABLED=false

# ZarinPal (sandbox in development)
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000

# Object storage (Runflare S3). Leave unset to use local ./uploads in development.
# S3_ENDPOINT=https://s3-pish.runflare.cloud
# S3_REGION=us-east-1
# S3_BUCKET=adx-storage
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Optional public URL override (defaults to S3_ENDPOINT/S3_BUCKET)
# S3_PUBLIC_URL=https://s3-pish.runflare.cloud/adx-storage
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=b3e097a4-33f3-4285-a756-4afa54230357
# Public callback hit by ZarinPal after payment (must be reachable by browser)
ZARINPAL_CALLBACK_URL=http://localhost:3000/v1/payments/callback

# Firebase Admin (FCM HTTP v1). Leave unset to skip sending push.
# Runflare/Docker: use base64 so quotes and \n do not break the image build:
#   base64 -i firebase-adminsdk.json | tr -d '\n'
# FIREBASE_SERVICE_ACCOUNT_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
# Local / hosts that accept raw JSON:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"adxplore",...}
# Or a local file path (relative to the backend repo root):
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-adminsdk.json
