# App
PORT=3000
NODE_ENV=development

# Database (SQLite for local MVP — switch to PostgreSQL later via DATABASE_URL)
DATABASE_URL="file:./prisma/dev.db"

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS (panel origin)
CORS_ORIGIN=https://app.adxplore.ir,http://localhost:5173

# Melipayamak SMS (never commit real path/key)
# Example: /api/send/shared/YOUR_KEY
SMS_MELIPAYAMAK_PATH=
SMS_BODY_OTP=420054

# OTP settings
OTP_LENGTH=5
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
